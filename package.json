{
  "name": "canopy",
  "private": true,
  "version": "1.0.0",
  "description": "Satellite-measured schoolyard canopy and surface temperature, turned into a costed planting plan.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/fixtures-synth",
    "packages/render",
    "packages/adapters/*",
    "apps/web",
    "tools/ingest"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "build": "npm run typecheck && npm run build --workspace apps/web",
    "dev": "npm run dev --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "fixtures": "vite-node tools/ingest/src/write-fixtures.ts",
    "assets": "CANOPY_WRITE=1 vite-node tools/ingest/src/write-assets.ts",
    "images": "CANOPY_WRITE=1 vite-node tools/ingest/src/write-images.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
